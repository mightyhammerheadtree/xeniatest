{
  "name": "xenorecomp-web",
  "version": "0.1.0",
  "description": "Xenon Recompiler for the web: recompiles Xbox 360 (Xenon PPC) binaries to WebAssembly in the browser, runs them in-page, and exports a project zip.",
  "type": "module",
  "private": true,
  "license": "BSD-3-Clause",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/server.js",
    "test": "npm run test:recomp && npm run test:elf && npm run test:web && npm run test:hle && npm run test:gpu",
    "test:recomp": "node --test core/tests/test_recompiler.mjs",
    "test:elf": "node --test core/tests/test_elf_loader.mjs",
    "test:web": "node --test core/tests/test_webapp.mjs",
    "build:hle-bundle": "node tools/build_hle_bundle.mjs",
    "test:hle": "node --test core/tests/test_hle_xex.mjs core/tests/test_hle_bundle.mjs core/tests/test_hle_exports.mjs",
    "test:gpu": "node --test core/tests/test_gpu_pm4.mjs core/tests/test_gpu_webgpu.mjs"
  },
  "dependencies": {
    "compression": "^1.7.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "jsdom": "^31.0.1"
  }
}
